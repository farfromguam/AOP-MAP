      "build_id",
      "parcel_id",
      "permanent_identifier",
      "osm_id",
      "ID",
      "edge_id",
      "logo_id",
      "source_id"
    ],
    "source": [
      "source",
      "source_name",
      "footprint_source",
      "source_type",
      "parcel_source",
      "burial_source",
      "attribution"
    ],
    "confidence": [
      "confidence",
      "number_confidence"
    ],
    "permission": [
      "permission",
      "license_or_permission",
      "license",
      "burial_terms"
    ],
    "status": [
      "status",
      "publish_status",
      "review_status"
    ],
    "last_checked": [
      "last_checked",
      "retrieved_on",
      "validation_method",
      "image_date",
      "production_date",
      "publication_date",
      "generated_on"
    ]
  },
  "rebake": {
    "mode": "additive (canonical fields prepended; original keys preserved)",
    "raw_archive": "website/data/raw/ (pristine pre-rebake originals)",
    "machine_layers": "id + kind per feature only; provenance is layer-level (below)"
  },
